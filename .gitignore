# Dependencies
node_modules/
__pycache__/
*.pyc
.pyo
.pyd

# Build
dist/
*.egg-info/
.eggs/

# Data (runtime)
data/*.db
data/*.json
!data/config.example.json
data/imports/*
!data/imports/.gitkeep
data/logs/
src/data/

# Workspace (research outputs)
workspace/team/*/
workspace/backtest/*/
workspace/recommend/*/
!workspace/**/.gitkeep
# workspace/research/ is tracked (valuable long-lived artifacts)

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local
.venv/
venv/

# Test
coverage/
.pytest_cache/

# Worktrees
.worktrees/

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv
*.bcf
*.run.xml

# Research rendered PDF rasters: only the current full render is tracked.
# Historical full-* dirs stay on disk for audit but are gitignored to bound repo growth.
workspace/research/*/rendered/full-*/
!workspace/research/*/rendered/full-20260620-0224/
!workspace/research/*/rendered/full-20260620-0224/**
