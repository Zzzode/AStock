      {
        "file": "review_log.md",
        "condition": "R0_or_R1_review_triggered",
        "description": "更新审查日志"
      },
      {
        "file": "skill_evolution_log.json",
        "condition": "proxy_field_upgraded_or_process_improved",
        "description": "记录技能进化"
      }
    ],
    "review_triggers": [
      {
        "id": "R0-trigger",
        "condition": "字段变化数量 > 5",
